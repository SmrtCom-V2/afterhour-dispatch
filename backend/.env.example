# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fm_afterhours

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Server
PORT=3000
NODE_ENV=development

# Telephony Provider (provider-agnostic)
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --- After-hours number provisioning (spec: AFTERHOUR_PHONE_NUMBER_PROVISIONING_SPEC.md) ---
# Voice webhook every provisioned customer number points at. MUST match the
# live direct-Twilio voice entrypoint or inbound calls silently fail.
TWILIO_VOICE_WEBHOOK_URL=https://api-afterhour.smrtcom.com/poc-voice-incoming
# German regulatory bundle + address the account uses to buy German DIDs
# (already approved on the live account — see the test checklist doc).
TWILIO_PROVISIONING_BUNDLE_SID=BU...
TWILIO_PROVISIONING_ADDRESS_SID=AD...
# Customer-facing monthly price of a dedicated number, in cents (default 499 = €4.99).
TELEPHONY_DEDICATED_NUMBER_PRICE_CENTS=499
# Fallback Twilio monthly cost for internal cost reporting if the pricing API fails.
TELEPHONY_NUMBER_COST_FALLBACK_CENTS=100

# Ops alerting — SMS sent here if the backend crashes or the wake-up
# engine fails. Optional but strongly recommended in production; without
# it, failures are only visible in server logs. Uses the Twilio config above.
OPS_ALERT_PHONE=+491234567890

# Error tracking (Sentry). Optional — no-ops entirely if unset. Catches
# non-crashing errors (caught exceptions, bad routes) that opsAlert.js's
# crash-call alert never sees. Get a DSN from a free Sentry project.
SENTRY_DSN=

# Voice AI Provider (provider-agnostic)
VOICE_AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key

# Push notifications (mobile companion app), used by notificationChannel.js's
# 'push' channel. Firebase service account JSON, base64-encoded onto one line
# (`base64 -w0 service-account-key.json` or PowerShell equivalent). Optional —
# push silently no-ops and falls back to voice/SMS if unset.
FIREBASE_SERVICE_ACCOUNT=base64-encoded-service-account-json

# Email — signup verification, password reset, morning reports, etc.
# Preferred path: Gmail OAuth2, sending as the noreply@smrtcom.com alias
# via the admin@smrtcom.com Workspace account (this Workspace edition has
# no App Passwords, so OAuth2 is required, not optional). Leave all four
# GMAIL_OAUTH_* unset until you've completed
# GOOGLE_OAUTH2_EMAIL_SETUP_GUIDE.md — do NOT fill in placeholder values,
# a partially-set block here can look configured when it isn't.
GMAIL_OAUTH_USER=admin@smrtcom.com
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# From header — Gmail lets the OAuth2-authenticated account send as any
# of its verified "Send mail as" aliases, so this can be the alias even
# though auth happens as GMAIL_OAUTH_USER above.
EMAIL_FROM=24-7 Dispatch <noreply@smrtcom.com>

# Fallback only — legacy plain SMTP path, kept for any future non-Gmail
# provider. Ignored whenever the GMAIL_OAUTH_* vars above are all set.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourcompany.com

# Storage (for SP report photos)
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
# For S3:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=eu-central-1

# App Config
DEFAULT_AI_CONFIDENCE_THRESHOLD=80
SP_CALL_TIMEOUT_SECONDS=120
SP_SMS_TIMEOUT_SECONDS=600
MORNING_REPORT_HOUR=7
SP_REPORT_DEADLINE_HOUR=9

# Super Admin allowlist (comma-separated emails)
SUPER_ADMIN_EMAILS=

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_ID_STARTER=price_starter_id
STRIPE_PRICE_ID_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_id
# Recurring Price for the "Dedicated after-hours number" add-on (€4.99/mo, EUR).
# Create in the Stripe dashboard, paste the price_... id here. Without it the
# number choice at checkout still works but no charge is applied.
STRIPE_PRICE_ID_DEDICATED_NUMBER=price_dedicated_number_id

# Frontend URL (for email links and redirects)
FRONTEND_URL=http://localhost:5175
