# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fm_afterhours

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Server
PORT=3000
NODE_ENV=development

# Telephony Provider (provider-agnostic)
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Ops alerting — SMS sent here if the backend crashes or the wake-up
# engine fails. Optional but strongly recommended in production; without
# it, failures are only visible in server logs. Uses the Twilio config above.
OPS_ALERT_PHONE=+491234567890

# Voice AI Provider (provider-agnostic)
VOICE_AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key

# Email (for morning reports)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourcompany.com

# Storage (for SP report photos)
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
# For S3:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=eu-central-1

# App Config
DEFAULT_AI_CONFIDENCE_THRESHOLD=80
SP_CALL_TIMEOUT_SECONDS=120
SP_SMS_TIMEOUT_SECONDS=600
MORNING_REPORT_HOUR=7
SP_REPORT_DEADLINE_HOUR=9

# Super Admin allowlist (comma-separated emails)
SUPER_ADMIN_EMAILS=

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_ID_STARTER=price_starter_id
STRIPE_PRICE_ID_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_id

# Frontend URL (for email links and redirects)
FRONTEND_URL=http://localhost:5175
